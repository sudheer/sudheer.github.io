---
import { getCollection } from 'astro:content';
import BaseLayout from '@sudheer/marcus-astro-theme/layouts/BaseLayout.astro';
import PostSection from '@sudheer/marcus-astro-theme/components/PostSection.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const micro = (await getCollection('micro', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout title="SuDo">
  <div class="content intro">
    <p class="muted">
      This space is where I share my ‘Today I Learned’ moments and other explorations in tech, life, and beyond.
    </p>
  </div>

  <PostSection title="Posts" href="posts" items={posts.slice(0, 5)} />
  <PostSection title="Micro" href="micro" items={micro.slice(0, 5)} />
</BaseLayout>

<style>
  .intro {
    margin-top: 2rem;
    font-size: 1.08rem;
  }
</style>
